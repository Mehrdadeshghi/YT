 "gemini_style": "A 17-year-old girl telling a true story that still scares her: hushed, tense, intimate, natural pauses before the reveals, rising fear at the end. Not theatrical.",
 "hook": [
  "A TEXT FROM",
  "MY OWN NUMBER"
 ],
 "cta": {
  "q": "Who is outside the door?"
 },
 "vo_open": [
  {
   "at": 0.15,
   "text": "At eleven fifty-eight p m, I got a text from my own number.",
   "cap": "At *11:58 p.m.,* I got a text from my *own number.*",
   "de": "Um 23:58 Uhr bekam ich eine Nachricht von meiner eigenen Nummer.",
   "es": "A las 11:58 de la noche recibí un mensaje de mi propio número.",
   "fr": "À 23h58, j’ai reçu un message de mon propre numéro."
  }
 ],
 "scenes": [
  {
   "dur": 1.0,
   "beat": "text",
   "vo": [
    {
     "at": 0.15,
     "text": "It said: don't open the door. Sent... tomorrow.",
     "cap": "It said: *don't open the door.* Sent... *tomorrow.*",
     "de": "Da stand: Mach die Tür nicht auf. Gesendet… morgen.",
     "es": "Decía: no abras la puerta. Enviado… mañana.",
     "fr": "Il disait : n’ouvre pas la porte. Envoyé… demain."
    }
   ],
   "hf": {
    "tpl": "plain",
    "name": "text"
   }
  },
  {
   "dur": 1.0,
   "beat": "laugh",
   "vo": [
    {
     "at": 0.15,
     "text": "I laughed. A glitch, right? Then someone knocked.",
     "cap": "I *laughed.* A *glitch,* right? Then someone *knocked.*",
     "de": "Ich lachte. Ein Fehler, oder? Dann klopfte jemand.",
     "es": "Me reí. Un fallo, ¿no? Entonces alguien llamó a la puerta.",
     "fr": "J’ai ri. Un bug, non ? Puis quelqu’un a frappé."
    }
   ],
   "hf": {
    "tpl": "plain",
    "name": "laugh"
   }
  },
  {
   "dur": 1.0,
   "beat": "alone",
   "vo": [
    {
     "at": 0.15,
     "text": "Mom was on a night shift. I was alone.",
     "cap": "Mom was on a *night shift.* I was *alone.*",
     "de": "Mama hatte Nachtschicht. Ich war allein.",
     "es": "Mamá tenía turno de noche. Estaba sola.",
     "fr": "Maman était de garde de nuit. J’étais seule."
    }
   ],
   "hf": {
    "tpl": "plain",
    "name": "alone"
   }
  },
  {
   "dur": 1.0,
   "beat": "second",
   "vo": [
    {
     "at": 0.15,
     "text": "Another text from me: look through the peephole. Don't make a sound.",
     "cap": "Another text from *me:* look through the *peephole.* Don't make a *sound.*",
     "de": "Noch eine Nachricht von mir: Schau durch den Türspion. Mach kein Geräusch.",
     "es": "Otro mensaje mío: mira por la mirilla. No hagas ruido.",
     "fr": "Un autre message de moi : regarde par le judas. Ne fais pas de bruit."
    }
   ],
   "hf": {
    "tpl": "plain",
    "name": "second"
   }
  },
  {
   "dur": 1.0,
   "beat": "reveal",
   "vo": [
    {
     "at": 0.15,
     "text": "So I looked. And the girl standing outside... was me.",
     "cap": "So I *looked.* And the girl standing outside... was *me.*",
     "de": "Also schaute ich. Und das Mädchen da draußen… war ich.",
     "es": "Así que miré. Y la chica que estaba afuera… era yo.",
     "fr": "Alors j’ai regardé. Et la fille dehors… c’était moi."
    }
   ],
   "hf": {
    "tpl": "plain",
    "name": "reveal"
   }
  },
  {
   "dur": 1.0,
   "beat": "cta",
   "vo": [
    {
     "at": 0.15,
     "text": "So who is standing outside my door? Part two tomorrow.",
     "cap": "So who is standing outside my *door?* Part *two* tomorrow.",
     "de": "Wer steht also vor meiner Tür? Teil zwei morgen.",
     "es": "¿Entonces quién está frente a mi puerta? Segunda parte mañana.",
     "fr": "Alors qui est devant ma porte ? Deuxième partie demain.",
     "cta": true
    }
   ],
   "hf": {
    "tpl": "plain",
    "name": "cta"
   }
  }
